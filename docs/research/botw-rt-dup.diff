+#ifdef GAME_BOTW
+/* The same texture level / layer at more than one colour slot (rt_dup_of, nvn_obj.h; nvn_mtl.m BOTW_RT_DUP_*): only the
+   first slot is attached, a later one is left a hole (writes discarded), and its clears go to the first. Breath of the
+   Wild's G-buffer passes attach the albedo and the normals twice each (c1 = c2, c3 = c4) with channel write masks 0 on
+   the second ones; the Switch's ROP writes only unmasked channels, so the slots do not interfere. Here both slots were
+   attachments of one VkImage, which Vulkan leaves undefined: Turnip keeps each attachment in its own GMEM copy and
+   stores both at the end of each pass, so the second slot's copy (loaded at the pass start, never written) overwrote the
+   first slot's writes. The albedo then kept the previous frame's pixels wherever the scene moved: a stale image of the
+   characters blended into the lit scene ("onion skinning" in cutscenes and dialogue).
+   TOTK_BOTW_RT_DUP=0 attaches every slot again (the negative control). */
+static int botw_rt_dup(int i) {
+    static int on = -1; if (on < 0) { const char *e = getenv("TOTK_BOTW_RT_DUP"); on = !(e && !strcmp(e, "0")); if (!on) LOGV("TOTK_BOTW_RT_DUP=0: duplicate colour slots are attached"); }
+    if (!on || !S.has_rt || i <= 0 || i >= S.rt.n || i >= 8) return -1;
+    int j = rt_dup_of(&S.rt, i);
+    if (j >= 0) { static int said; if (!said++) LOGV("[botw] colour slot %d holds the same image as slot %d (serial %llu): left unattached (rt_dup_of)", i, j, (unsigned long long)S.rt.color[i]->serial); }
+    return j;
+}
+#else
+#define botw_rt_dup(i) (-1)
+#endif
